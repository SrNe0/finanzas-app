# Copia de este archivo a ".env" (el script de instalación lo hace por ti si no existe).
#
# Base de datos SQLite local. La ruta es relativa a la carpeta "prisma" de apps/api,
# así que este valor deja la base en apps/data/finanzas.db (esa carpeta no se versiona).
DATABASE_URL="file:../../data/finanzas.db"
